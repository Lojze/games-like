---
/**
 * 全站统一游戏卡片。首页 / 标签聚合页 / 游戏详情页都复用这一个组件。
 *
 * 结构（自上而下）：
 *   1. 主封面（GameCover，自带首字母渐变兜底）
 *   2. 截图条：screenshots 前 3 张缩略图，点击打开全屏 Lightbox；无截图时整块不渲染
 *   3. 文本区：游戏名（可链到站内推荐页）、评分/年份/类型 Badge、感受标签 chips、可选简介
 *   4. Why it fits：优先用 reasons.json 的专属文案；缺失时调用规则引擎生成。
 *      传入 whyHeading 时，标签升级为语义化的 <h3>Why {游戏名} feels similar</h3>，
 *      供 AI 爬虫 / 屏幕阅读器识别「这张卡为什么被推荐」的逻辑层级（详情页使用）。
 *   5. 底部按钮区 .gc__actions（flex 容器，已预留多按钮位）：
 *      View on Steam ↗，以及有预告片时的 ▶ Watch Trailer
 *
 * feelTags 是可选的展示层辅助信息：首页 / 标签聚合页 / 详情页三个页面
 * 都通过 utils/feel-tags.ts 的 pickFeelTags() 统一选取（去重、trending 优先、
 * 最多 3 个）后传入，保证同一款游戏在全站任意位置展示的感受标签一致；
 * 不传时整块不渲染。
 * Lightbox 脚本用事件委托，整页只初始化一次，可左右切换 / ESC 关闭。
 *
 * movies 是可选的 HLS 预告片数据（{ hlsUrl, thumbnail }）。传入且有可用
 * hlsUrl 时，按钮区多出一个 "▶ Watch Trailer"。播放器弹窗脚本也在本组件里，
 * 用 .js-trailer + data-* 事件委托统一驱动：详情页 Hero 区的按钮复用同一套
 * 逻辑；首页 / 标签页不传 movies，因此不会出现点了没反应的按钮。
 * 关闭弹窗会 destroy hls.js 实例、pause 并清空 src，防止后台继续拉流。
 */
import GameCover from './GameCover.astro';
import type { MetaBadge } from '../utils/tag-translator';
import { generateWhyItFits } from '../../config/why-it-fits';
import { TRENDING_FEELS } from '../../config/trending-feels';

export interface GameScreenshot {
  path_thumbnail: string;
  path_full: string;
}

/** Steam appdetails 的 HLS 预告片（由 scripts/fetch-screenshots.ts 写入） */
export interface GameMovie {
  hlsUrl: string;
  thumbnail: string;
}

interface Props {
  name: string;
  slug: string;
  cover: string | null;
  /** 占位封面色相，由 slug 稳定派生 */
  hue: number;
  badges: MetaBadge[];
  screenshots?: GameScreenshot[];
  steamUrl?: string;
  /** 卡片标题的站内/站外链接；不传则标题为纯文本 */
  href?: string;
  hrefExternal?: boolean;
  /** reasons.json 里的专属推荐文案；不传则由规则引擎现场生成 */
  reason?: string;
  /**
   * GEO 语义标题：传入后 "Why it fits" 标签换成
   * <h3>{whyHeading}</h3>（视觉仍是 .gc__why-tag 小标签样式）。
   * 只在详情页传入，首页 / 标签页保持原来的 "Why it fits" 文案。
   */
  whyHeading?: string;
  /** 卡片辅助信息里展示的感受标签（按优先级排好序传入）；不传则不渲染 */
  feelTags?: string[];
  /** HLS 预告片；有可用 hlsUrl 时显示 Watch Trailer 按钮 */
  movies?: GameMovie[];
  /** 详情页用的 150 字简介 */
  blurb?: string;
  /** 规则引擎兜底所需的上下文 */
  sourceName?: string;
  sharedTags?: string[];
  index?: number;
  compact?: boolean;
}

const {
  name,
  slug,
  cover,
  hue,
  badges = [],
  screenshots = [],
  feelTags = [],
  movies = [],
  steamUrl,
  href,
  hrefExternal = false,
  reason,
  whyHeading,
  blurb,
  sourceName,
  sharedTags = [],
  index = 0,
  compact = false,
} = Astro.props;

const shots = screenshots
  .filter(
    (shot): shot is GameScreenshot =>
      Boolean(shot) &&
      typeof shot.path_thumbnail === 'string' &&
      typeof shot.path_full === 'string',
  )
  .slice(0, 3);

// 优先读离线生成的专属文案；没有数据时退回高质量规则引擎，绝不出现空白
const why =
  reason?.trim() ||
  (sourceName && sharedTags.length > 0
    ? generateWhyItFits(sourceName, name, sharedTags, index)
    : '');

const steam =
  steamUrl && steamUrl !== '#'
    ? steamUrl
    : `https://store.steampowered.com/search/?term=${encodeURIComponent(name)}`;

// 同一张卡片的 3 张截图归为一组，Lightbox 内可左右切换
const group = `shots-${slug.replace(/[^a-zA-Z0-9-]/g, '')}`;

// 感受标签 chip 的展示文案：把内部连字符词形还原成可读标题
const prettyTag = (tag: string): string =>
  tag.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

// 一个播放器一次只播一个视频：取第一条带 HLS 流的预告片
const trailer = movies.find(
  (movie) => movie && typeof movie.hlsUrl === 'string' && movie.hlsUrl.length > 0,
);
---

<article class:list={['gc', { 'gc--compact': compact }]}>
  <div class="gc__cover">
    <GameCover name={name} cover={cover} hue={hue} />
  </div>

  {
    shots.length > 0 && (
      <div class="gc__shots" aria-label={`Screenshots from ${name}`}>
        {shots.map((shot, i) => (
          <button
            class="gc__shot"
            type="button"
            data-lightbox-group={group}
            data-full={shot.path_full}
            aria-label={`Open full-size screenshot ${i + 1} of ${name}`}
          >
            <span class="gc__shot-ph" aria-hidden="true">▣</span>
            <img
              src={shot.path_thumbnail}
              alt={`${name} gameplay screenshot ${i + 1}`}
              loading="lazy"
            />
            <span class="gc__shot-zoom" aria-hidden="true">⤢</span>
          </button>
        ))}
      </div>
    )
  }

  <div class="gc__body">
    <h3 class="gc__title">
      {
        href ? (
          <a
            href={href}
            target={hrefExternal ? '_blank' : undefined}
            rel={hrefExternal ? 'noopener noreferrer' : undefined}
          >
            {name}
          </a>
        ) : (
          name
        )
      }
    </h3>

    {
      badges.length > 0 && (
        <div class="badges gc__badges">
          {badges.map((badge) => (
            <span class:list={['badge', `badge--${badge.tone}`]} title={badge.text}>
              {badge.text}
            </span>
          ))}
        </div>
      )
    }

    {
      feelTags.length > 0 && (
        <div class="gc__feels" aria-label="Feel tags">
          {feelTags.map((tag) => (
            <a
              class:list={['gc__feel', { 'gc__feel--trending': TRENDING_FEELS.includes(tag) }]}
              href={`/tags/${tag}`}
              title={`Browse all ${prettyTag(tag)} games`}
            >
              {prettyTag(tag)}
            </a>
          ))}
        </div>
      )
    }

    {blurb && <p class="gc__blurb">{blurb}</p>}

    {
      why && (
        <div class="gc__why">
          {whyHeading ? (
            <h3 class="gc__why-tag gc__why-tag--heading">{whyHeading}</h3>
          ) : (
            <span class="gc__why-tag">Why it fits</span>
          )}
          <p class="gc__why-text">{why}</p>
        </div>
      )
    }

    <!-- 底部购买/外链按钮区：排布由 .gc__actions 统一负责（等分、换行、贴底对齐）。
         Watch Trailer 与联盟购买按钮都可在此容器内直接追加，无需改动 CSS。 -->
    <div class="gc__actions">
      {
        trailer && (
          <button
            class="trailer-btn gc__trailer js-trailer"
            type="button"
            data-hls={trailer.hlsUrl}
            data-poster={trailer.thumbnail}
            data-title={`${name} — official trailer`}
            aria-label={`Watch the ${name} trailer`}
          >
            <span aria-hidden="true">▶</span>
            <span>Watch Trailer</span>
          </button>
        )
      }
      <a
        class="steam-btn"
        href={steam}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`View ${name} on Steam`}
      >
        <svg
          class="steam-btn__icon"
          viewBox="0 0 24 24"
          width="17"
          height="17"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9.4" />
          <path d="M11.2 9.7 L16.7 13.5" />
          <circle cx="8.1" cy="9.0" r="2.5" fill="currentColor" stroke="none" />
          <circle cx="16.6" cy="14.6" r="2.0" fill="currentColor" stroke="none" />
        </svg>
        <span>View on Steam</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>

<script>
  (() => {
    const root = document.documentElement;
    // 事件委托：整页只挂一次，避免每张卡片重复初始化
    if (root.dataset.gcLightbox === '1') return;
    root.dataset.gcLightbox = '1';

    const overlay = document.createElement('div');
    overlay.className = 'gc-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', 'Screenshot viewer');
    overlay.innerHTML = `
      <button class="gc-lightbox__close" type="button" aria-label="Close screenshot">×</button>
      <button class="gc-lightbox__nav gc-lightbox__nav--prev" type="button" aria-label="Previous screenshot">‹</button>
      <figure class="gc-lightbox__figure">
        <img class="gc-lightbox__img" alt="" />
        <figcaption class="gc-lightbox__caption"></figcaption>
      </figure>
      <button class="gc-lightbox__nav gc-lightbox__nav--next" type="button" aria-label="Next screenshot">›</button>
    `;
    document.body.appendChild(overlay);

    const img = overlay.querySelector('.gc-lightbox__img') as HTMLImageElement;
    const caption = overlay.querySelector('.gc-lightbox__caption') as HTMLElement;
    let items: HTMLButtonElement[] = [];
    let current = 0;

    function show(position: number): void {
      if (!items.length) return;
      current = (position + items.length) % items.length;
      const button = items[current];
      img.src = button.dataset.full ?? '';
      img.alt = button.getAttribute('aria-label') ?? 'Game screenshot';
      caption.textContent = `${current + 1} / ${items.length}`;
    }

    function open(button: HTMLButtonElement): void {
      const group = button.dataset.lightboxGroup;
      items = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          `.gc__shot[data-lightbox-group="${group}"]`,
        ),
      );
      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      const at = items.indexOf(button);
      show(at < 0 ? 0 : at);
    }

    function close(): void {
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
      img.removeAttribute('src');
    }

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const shot = target.closest<HTMLButtonElement>('.gc__shot');
      if (shot) {
        open(shot);
        return;
      }
      if (target.closest('.gc-lightbox__close')) close();
      else if (target.closest('.gc-lightbox__nav--prev')) show(current - 1);
      else if (target.closest('.gc-lightbox__nav--next')) show(current + 1);
      else if (target === overlay) close();
    });

    document.addEventListener('keydown', (event) => {
      if (!overlay.classList.contains('is-open')) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowLeft') show(current - 1);
      else if (event.key === 'ArrowRight') show(current + 1);
    });

    // 缩略图加载失败时隐藏 <img>，露出底层渐变占位，不出现破图图标
    function guardShots(): void {
      document.querySelectorAll<HTMLImageElement>('.gc__shot img').forEach((el) => {
        const hide = (): void => el.classList.add('is-hidden');
        el.addEventListener('error', hide, { once: true });
        if (el.complete && el.naturalWidth === 0) hide();
      });
    }
    guardShots();
    document.addEventListener('astro:page-load', guardShots);
  })();
</script>

<script>
  /**
   * HLS 预告片弹窗（整页只初始化一次，事件委托覆盖卡片 + 详情页 Hero 的
   * 所有 .js-trailer 按钮，按钮通过 data-hls / data-poster / data-title 传值）。
   *
   * 播放策略：
   *   - Safari / iOS 原生支持 HLS → 直接把 m3u8 交给 <video src>；
   *   - 其它浏览器 → 动态 import('hls.js') 走 MSE（不影响首屏体积）；
   *   - 两者都不支持时仍把 m3u8 交给 <video>，由浏览器自行决定。
   * 关闭时 destroy hls.js 实例 + pause + 移除 src + load()，彻底断开拉流，
   * 避免弹窗关掉后视频仍在后台占用带宽。
   */
  (() => {
    const root = document.documentElement;
    if (root.dataset.trailerPlayer === '1') return;
    root.dataset.trailerPlayer = '1';

    // 只依赖结构类型的 destroy()，避免把 hls.js 的类型静态拉进主包
    let hls: { destroy(): void } | null = null;

    const overlay = document.createElement('div');
    overlay.className = 'trailer-modal';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', 'Game trailer player');
    overlay.innerHTML = `
      <div class="trailer-modal__backdrop" data-trailer-close></div>
      <div class="trailer-modal__panel">
        <div class="trailer-modal__bar">
          <span class="trailer-modal__title"></span>
          <button class="trailer-modal__close" type="button" data-trailer-close aria-label="Close trailer">✕ Close</button>
        </div>
        <video class="trailer-modal__video" controls playsinline preload="none"></video>
      </div>
    `;
    document.body.appendChild(overlay);

    const video = overlay.querySelector('video') as HTMLVideoElement;
    const title = overlay.querySelector('.trailer-modal__title') as HTMLElement;

    function destroyHls(): void {
      if (hls) {
        hls.destroy();
        hls = null;
      }
    }

    function close(): void {
      destroyHls();
      video.pause();
      video.removeAttribute('src');
      video.removeAttribute('poster');
      video.load(); // 释放已缓冲的分片 / MSE 连接
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
      title.textContent = '';
    }

    function tryPlay(): void {
      const attempt = video.play();
      if (attempt && typeof attempt.catch === 'function') {
        attempt.catch(() => {
          // 自动播放策略常要求静音：静音后重试，控件里仍可手动打开声音
          video.muted = true;
          void video.play().catch(() => {});
        });
      }
    }

    async function open(button: HTMLElement): Promise<void> {
      const url = button.dataset.hls ?? '';
      if (!url) return;

      // 切换视频前先清掉上一个实例
      destroyHls();
      video.pause();
      video.removeAttribute('src');
      video.muted = false;

      title.textContent = button.dataset.title ?? 'Game trailer';
      const poster = button.dataset.poster ?? '';
      if (poster) video.poster = poster;
      else video.removeAttribute('poster');

      overlay.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      const nativeHls = Boolean(video.canPlayType('application/vnd.apple.mpegurl'));
      if (nativeHls) {
        video.src = url;
        tryPlay();
        return;
      }

      const { default: Hls } = await import('hls.js');
      // 动态 import 期间用户可能已经关掉弹窗，此时不要再创建实例拉流
      if (!overlay.classList.contains('is-open')) return;

      if (!Hls.isSupported()) {
        video.src = url;
        tryPlay();
        return;
      }

      const instance = new Hls({ enableWorker: true });
      hls = instance;
      instance.loadSource(url);
      instance.attachMedia(video);
      instance.on(Hls.Events.MANIFEST_PARSED, () => tryPlay());
      instance.on(Hls.Events.ERROR, (_event, data) => {
        if (data.fatal) destroyHls();
      });
    }

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      const trigger = target.closest<HTMLElement>('.js-trailer');
      if (trigger) {
        void open(trigger);
        return;
      }
      if (overlay.classList.contains('is-open') && target.closest('[data-trailer-close]')) {
        close();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && overlay.classList.contains('is-open')) close();
    });

    document.addEventListener('astro:page-load', () => {
      if (overlay.classList.contains('is-open')) close();
    });
    window.addEventListener('pagehide', close);
  })();
</script>
